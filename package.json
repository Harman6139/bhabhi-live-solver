{
  "name": "getaway-live-solver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:phase1": "vitest run tests/domain tests/rules tests/events",
    "test:property": "vitest run tests/property",
    "test:property:rules": "vitest run tests/property/rules.property.test.ts",
    "test:integration": "vitest run tests/integration",
    "test:inference": "vitest run tests/inference",
    "test:inference-property": "vitest run tests/property/inference.property.test.ts",
    "test:truth-firewall": "vitest run tests/truth-firewall",
    "test:simulator": "vitest run tests/simulator",
    "test:evaluation": "vitest run tests/evaluation",
    "test:solver": "vitest run tests/search",
    "test:actor-safety": "vitest run tests/agents",
    "test:calibration": "vitest run tests/calibration",
    "test:strategy": "vitest run tests/strategy",
    "test:phase7": "vitest run tests/search/exact-hypotheses.test.ts tests/search/exact-endgame.test.ts tests/search/exact-endgame-oracle.test.ts tests/search/exact-information-state.test.ts tests/search/exact-endgame-dispatch.test.ts tests/search/exact-long-horizon.test.ts tests/search/model-sensitivity.test.ts tests/search/exact-model-sensitivity.test.ts tests/search/research-dispatch.test.ts tests/search/advanced-truth-firewall.test.ts tests/simulator/evaluation-user-timeline-policy.test.ts tests/evaluation/phase7-search-policy.test.ts tests/evaluation/phase7-comparison-schema.test.ts tests/evaluation/phase7-comparison-artifacts.test.ts tests/evaluation/phase7-comparison-runner.test.ts tests/strategy/phase7-evidence.test.ts",
    "test:e2e": "npm run build && playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gate:phase1": "npm run format:check && npm run lint && npm run typecheck && npm run test:phase1 && npm run test:property:rules && npm run build",
    "gate:phase2": "npm run gate:phase1 && npm run test:integration && npm run test:e2e",
    "gate:phase3": "npm run gate:phase2 && npm run test:inference && npm run test:inference-property && npm run test:truth-firewall",
    "gate:phase4": "npm run gate:phase3 && npm run test:simulator && npm run test:evaluation",
    "gate:phase5": "npm run gate:phase4 && npm run test:solver && npm run test:actor-safety",
    "gate:phase6": "npm run gate:phase5 && npm run test:calibration && npm run test:strategy && npm run gate:phase6:strategy && npm run gate:phase6:strategy:artifact && npm run gate:phase6:calibration",
    "eval:phase4": "tsx scripts/run-phase4-smoke.ts",
    "eval:verify": "tsx scripts/verify-evaluation.ts",
    "bench:phase5": "tsx scripts/bench-phase5.ts",
    "bench:phase5:verify": "tsx scripts/verify-phase5-benchmark.ts",
    "eval:calibration": "tsx scripts/run-phase6-calibration.ts",
    "eval:calibration:verify": "tsx scripts/verify-phase6-calibration.ts",
    "eval:phase7": "tsx scripts/run-phase7-comparison.ts",
    "eval:phase7:smoke": "tsx scripts/run-phase7-comparison.ts --run-kind smoke --base-index-start 0 --base-count 1",
    "eval:phase7:primary": "tsx scripts/run-phase7-comparison.ts --run-kind development-primary --base-index-start 0 --base-count 4",
    "eval:phase7:reproduce": "tsx scripts/run-phase7-comparison.ts --run-kind development-reproduction --base-index-start 0 --base-count 4",
    "eval:phase7:verify": "tsx scripts/verify-phase7-comparison.ts",
    "eval:phase7:verify-reproduction": "tsx scripts/verify-phase7-reproduction.ts",
    "gate:phase6:strategy": "tsx scripts/run-phase6-strategy-evidence.ts --verify-only",
    "gate:phase6:strategy:artifact": "tsx scripts/verify-phase6-strategy-evidence.ts artifacts/strategy/phase6/phase6-strategy-evidence-20260728-b",
    "gate:phase6:calibration": "tsx scripts/verify-phase6-calibration.ts artifacts/calibration/eval-v1/dev/phase6-calibration-dev-20260728-b",
    "gate:phase7:strategy": "tsx scripts/run-phase6-strategy-evidence.ts --phase7 --verify-only",
    "gate:phase7:strategy:artifact": "tsx scripts/verify-phase6-strategy-evidence.ts --phase7 artifacts/strategy/phase7/phase7-strategy-evidence-20260728-b",
    "gate:phase7:comparison:smoke": "tsx scripts/verify-phase7-comparison.ts artifacts/evaluation/eval-v1/dev/phase7-comparison-smoke-v2-20260728-a",
    "gate:phase7:comparison:primary": "tsx scripts/verify-phase7-comparison.ts artifacts/evaluation/eval-v1/dev/phase7-comparison-dev-primary-v2-20260728-a",
    "gate:phase7:comparison:reproduction": "tsx scripts/verify-phase7-comparison.ts artifacts/evaluation/eval-v1/dev/phase7-comparison-dev-reproduction-v2-20260728-a",
    "gate:phase7:comparison:attestation": "tsx scripts/verify-phase7-reproduction.ts --smoke artifacts/evaluation/eval-v1/dev/phase7-comparison-smoke-v2-20260728-a --primary artifacts/evaluation/eval-v1/dev/phase7-comparison-dev-primary-v2-20260728-a --reproduction artifacts/evaluation/eval-v1/dev/phase7-comparison-dev-reproduction-v2-20260728-a --attestation artifacts/evaluation/eval-v1/dev/phase7-reproduction-attestations/phase7-reproduction-4839c387e40a7cf714f9",
    "gate:phase7:comparison": "npm run gate:phase7:comparison:smoke && npm run gate:phase7:comparison:primary && npm run gate:phase7:comparison:reproduction && npm run gate:phase7:comparison:attestation",
    "gate:phase7": "npm run gate:phase6 && npm run test:phase7 && npm run gate:phase7:strategy && npm run gate:phase7:strategy:artifact && npm run gate:phase7:comparison",
    "strategy:evidence:write": "tsx scripts/run-phase6-strategy-evidence.ts",
    "strategy:evidence:verify": "tsx scripts/verify-phase6-strategy-evidence.ts",
    "strategy:phase7:evidence:write": "tsx scripts/run-phase6-strategy-evidence.ts --phase7",
    "strategy:phase7:evidence:verify": "tsx scripts/verify-phase6-strategy-evidence.ts --phase7",
    "release:verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.9.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
